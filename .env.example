# Database (self-hosted Postgres). Local dev: localhost (use 5433 if a local
# Postgres already owns 5432). Under docker compose, use the service host: postgres.
DATABASE_URL=postgresql://explainmotion:explainmotion@localhost:5432/explainmotion
# docker compose: postgresql://explainmotion:explainmotion@postgres:5432/explainmotion

# Auth (Better Auth, self-hosted). Generate a strong secret for production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Public base URL the browser auth client calls (usually same origin = blank).
NEXT_PUBLIC_APP_URL=

# Queue (Redis). Under docker compose, use the service host: redis.
REDIS_URL=redis://localhost:6379
# docker compose: redis://redis:6379

# AI (planned; the current planner is a deterministic mock)
GEMINI_API_KEY=

# Media storage. STORAGE_PROVIDER=local keeps render outputs on disk; set to "r2"
# (or "s3") for private objects streamed through authenticated downloads.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
# Use the SAME absolute directory for web and worker in local development.
# Compose overrides this with /data/renders and mounts a shared volume.
RENDER_OUTPUT_DIR=/tmp/explainmotion-renders
RENDER_CONCURRENCY=1

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
