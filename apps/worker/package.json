{
  "name": "@explainmotion/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx ../web/scripts/check-env.ts && tsx src/worker.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
