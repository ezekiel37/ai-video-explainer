    "bullmq": "^5.34.2",
    "ioredis": "^5.4.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/pg": "^8.20.0"
  }
}
